# Copier en .env et renseigner les valeurs (le .env réel n'est jamais commité).

# ── PostgreSQL ──────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=15432
DB_NAME=vinted_bot
DB_USER=postgres
DB_PASSWORD=change-me

# ── Environnement ───────────────────────────────────────────
# "production" => JWT_SECRET fort OBLIGATOIRE (le serveur refuse de démarrer
# avec un secret absent/faible). "development" tolère un secret éphémère.
NODE_ENV=development

# ── Sécurité ────────────────────────────────────────────────
# Générer p.ex. avec :  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=remplace-par-une-valeur-aleatoire-de-64-hex
# Coût bcrypt (>= 12 recommandé).
BCRYPT_ROUNDS=12

# Compte admin — mot de passe appliqué en base par `npm run migrate`.
# Laisser ADMIN_PASSWORD vide => un mot de passe fort est généré et affiché une fois.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Origines autorisées par CORS (séparées par des virgules), p.ex. le domaine public.
CORS_ORIGIN=
